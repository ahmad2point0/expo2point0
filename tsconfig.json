{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": "./src",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@global/*": [
        "./global/*"
      ],
      "@features/*": [
        "./features/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}